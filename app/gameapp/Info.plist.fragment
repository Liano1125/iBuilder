<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- gameapp/Info.plist.fragment, merged into the Info.plist the SDK generates (PartialAppManifest in
     gameapp/build_gameapp.sh). A full plist, not loose key/value pairs: the SDK parses this file as a plist and
     merges its top-level dictionary, and a fragment without the wrapper is refused with "Failed to parse PList
     data type" (docs/DECISIONS.md trap 14).

     The scene lifecycle is required by iOS 27 (MT7199 at build time, the OS at launch); the class named here is
     [Register("GameAppSceneDelegate")] in gameapp/GameAppMain.cs. The two file-sharing keys are what let a user
     put prod.keys and a 1.4 GB dump into Documents at all: the first device run of this project stopped
     exactly there, with the folder invisible over Files (docs/DECISIONS.md and app-net/Info.plist.fragment). -->
<plist version="1.0">
<dict>
	<!-- A build keeps running when the user leaves the app: BGContinuedProcessingTask (gameapp/GameAppBackground.cs). The
	     identifier is the bundle id plus ".build." and a number; the wildcard is how iOS wants it permitted. CPU only: no
	     entitlement is needed (the GPU variant would need one a sideloading profile cannot carry). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.nxpocket.gameapp.build.*</string>
	</array>
	<!-- ProMotion: a display link may run above 60 Hz (the engine's 120 fps path; load/front_pad.m front_screen_max_fps) -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The launch screen: the app's night blue (Assets.xcassets/LaunchBackground), not a white flash before the
	     Ambient ground (gameapp/GameAppTheme.cs). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- A slim export's game files (Exports/<Name> [<title id>].romfs, gameapp/GameAppExport.cs): a type of their own,
	     so the exported app's picker shows only them. The exported app carries this plist too. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.nxpocket.ibuilder.romfs</string>
			<key>UTTypeDescription</key>
			<string>Switch 游戏文件</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>romfs</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- The in-game menu's Capture items save a screenshot or a clip to Photos, add-only: the app can put pictures there and cannot
	     read the library (load/front_capture.m, PHAccessLevelAddOnly). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>将你游玩时截取的截图和录屏保存到照片图库。</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The tool's own screen is portrait, the game is landscape (GameAppGameViewController): the app has to be
	     allowed both, or presenting the game view cannot rotate the phone. Which one a screen takes is decided by
	     each view controller's GetSupportedInterfaceOrientations. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- A universal app: an iPhone (1) and an iPad (2). The SDK's generated plist says iPhone only, and an iPhone-only app on an iPad
	     is a small window or a stretched one. Windowed multitasking (Split View, Slide Over, Stage Manager) is switched ON by saying
	     the app does not require full screen: the library re-lays itself out for the window's width (GameAppViewController.
	     ApplyAdaptiveLayout) and the game view takes whatever rectangle it is given (its drawable follows the layer's size, the
	     engine's layout places the picture and the controls), so nothing needs the whole screen. docs/DECISIONS.md 92. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>GameApp</string>
					<key>UISceneDelegateClassName</key>
					<string>GameAppSceneDelegate</string>
				</dict>
			</array>
			<!-- A TV or monitor (USB-C, AirPlay): the game's picture goes there and the phone becomes the controller
			     (gameapp/GameAppExternal.cs). iOS 26 offers this scene from the entry alone; iOS 27 only to an app that registers a
			     scene accessory, which the game window does while a game is on. The delegate makes no window of its own: with no
			     window iOS goes on mirroring the phone, which is what the menus and the "Mirror the iPhone" setting want. -->
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>ExternalDisplay</string>
					<key>UISceneDelegateClassName</key>
					<string>GameAppExternalSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
